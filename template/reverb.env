APP_ENV="${{relaticle.APP_ENV}}" # Laravel environment. Keep as production. Shared from the relaticle service.
APP_KEY="${{relaticle.APP_KEY}}" # Laravel encryption key (auto-generated, 32 bytes). Shared from the relaticle service.
APP_URL="${{relaticle.APP_URL}}" # Public URL of the app. Defaults to the Railway-provided domain. Shared from the relaticle service.
AUTORUN_ENABLED="false" # No migrations/caches on the websocket server.
CACHE_STORE="${{relaticle.CACHE_STORE}}" # Cache backend. Shared from the relaticle service.
DB_CONNECTION="${{relaticle.DB_CONNECTION}}" # Database driver. Postgres. Shared from the relaticle service.
DB_DATABASE="${{relaticle.DB_DATABASE}}" # Postgres database name, from the pg-relaticle service. Shared from the relaticle service.
DB_HOST="${{relaticle.DB_HOST}}" # Postgres host, from the pg-relaticle service. Shared from the relaticle service.
DB_PASSWORD="${{relaticle.DB_PASSWORD}}" # Postgres password, from the pg-relaticle service. Shared from the relaticle service.
DB_PORT="${{relaticle.DB_PORT}}" # Postgres port, from the pg-relaticle service. Shared from the relaticle service.
DB_USERNAME="${{relaticle.DB_USERNAME}}" # Postgres user, from the pg-relaticle service. Shared from the relaticle service.
LOG_CHANNEL="${{relaticle.LOG_CHANNEL}}" # Laravel log channel. stderr sends logs to Railway. Shared from the relaticle service.
REDIS_HOST="${{relaticle.REDIS_HOST}}" # Redis host, from the redis-relaticle service. Shared from the relaticle service.
REDIS_PASSWORD="${{relaticle.REDIS_PASSWORD}}" # Redis password, from the redis-relaticle service. Shared from the relaticle service.
REDIS_PORT="${{relaticle.REDIS_PORT}}" # Redis port, from the redis-relaticle service. Shared from the relaticle service.
REVERB_APP_ID="${{relaticle.REVERB_APP_ID}}" # Reverb app id (auto-generated). Shared from the relaticle service.
REVERB_APP_KEY="${{relaticle.REVERB_APP_KEY}}" # Reverb public key (auto-generated). Injected into the JS bundle at boot. Shared from the relaticle service.
REVERB_APP_SECRET="${{relaticle.REVERB_APP_SECRET}}" # Reverb secret (auto-generated). Shared from the relaticle service.
REVERB_HOST="${{RAILWAY_PUBLIC_DOMAIN}}" # This service's public host.
REVERB_PORT="${{relaticle.REVERB_PORT}}" # Reverb public port (Railway terminates TLS). Shared from the relaticle service.
REVERB_SCHEME="${{relaticle.REVERB_SCHEME}}" # Reverb public scheme. Shared from the relaticle service.
