ANTHROPIC_API_KEY="${{relaticle.ANTHROPIC_API_KEY}}" # Anthropic API key for Claude models. Optional. Shared from the relaticle service.
APP_DEBUG="${{relaticle.APP_DEBUG}}" # Enable Laravel debug mode. Keep false in production. Shared from the relaticle service.
APP_ENV="${{relaticle.APP_ENV}}" # Laravel environment. Keep as production. Shared from the relaticle service.
APP_KEY="${{relaticle.APP_KEY}}" # Laravel encryption key (auto-generated, 32 bytes). Shared from the relaticle service.
APP_NAME="${{relaticle.APP_NAME}}" # Application name shown in the UI and emails. Shared from the relaticle service.
APP_PANEL_DOMAIN="${{relaticle.APP_PANEL_DOMAIN}}" # Optional separate domain for the admin panel. Leave empty to serve on APP_URL. Shared from the relaticle service.
APP_URL="${{relaticle.APP_URL}}" # Public URL of the app. Defaults to the Railway-provided domain. Shared from the relaticle service.
AUTORUN_ENABLED="false" # No migrations/caches on workers.
BROADCAST_CONNECTION="${{relaticle.BROADCAST_CONNECTION}}" # Realtime broadcasting driver. Shared from the relaticle service.
CACHE_STORE="${{relaticle.CACHE_STORE}}" # Cache backend. Shared from the relaticle service.
DB_CONNECTION="${{relaticle.DB_CONNECTION}}" # Database driver. Postgres. Shared from the relaticle service.
DB_DATABASE="${{relaticle.DB_DATABASE}}" # Postgres database name, from the pg-relaticle service. Shared from the relaticle service.
DB_HOST="${{relaticle.DB_HOST}}" # Postgres host, from the pg-relaticle service. Shared from the relaticle service.
DB_PASSWORD="${{relaticle.DB_PASSWORD}}" # Postgres password, from the pg-relaticle service. Shared from the relaticle service.
DB_PORT="${{relaticle.DB_PORT}}" # Postgres port, from the pg-relaticle service. Shared from the relaticle service.
DB_USERNAME="${{relaticle.DB_USERNAME}}" # Postgres user, from the pg-relaticle service. Shared from the relaticle service.
LOG_CHANNEL="${{relaticle.LOG_CHANNEL}}" # Laravel log channel. stderr sends logs to Railway. Shared from the relaticle service.
LOG_LEVEL="${{relaticle.LOG_LEVEL}}" # Minimum log level. Shared from the relaticle service.
MAIL_ENCRYPTION="${{relaticle.MAIL_ENCRYPTION}}" # SMTP encryption. Shared from the relaticle service.
MAIL_FROM_ADDRESS="${{relaticle.MAIL_FROM_ADDRESS}}" # From address for outgoing email. Shared from the relaticle service.
MAIL_FROM_NAME="${{relaticle.MAIL_FROM_NAME}}" # From name for outgoing email. Shared from the relaticle service.
MAIL_HOST="${{relaticle.MAIL_HOST}}" # SMTP host. Only needed if MAIL_MAILER=smtp. Shared from the relaticle service.
MAIL_MAILER="${{relaticle.MAIL_MAILER}}" # Mail transport. log writes emails to the log. Set to smtp and fill MAIL_HOST/USERNAME/PASSWORD to send real email. Shared from the relaticle service.
MAIL_PASSWORD="${{relaticle.MAIL_PASSWORD}}" # SMTP password. Only needed if MAIL_MAILER=smtp. Shared from the relaticle service.
MAIL_PORT="${{relaticle.MAIL_PORT}}" # SMTP port. Shared from the relaticle service.
MAIL_USERNAME="${{relaticle.MAIL_USERNAME}}" # SMTP username. Only needed if MAIL_MAILER=smtp. Shared from the relaticle service.
OLLAMA_API_KEY="${{relaticle.OLLAMA_API_KEY}}" # Ollama cloud API key (https://ollama.com/settings/keys). Leave empty to skip. Shared from the relaticle service.
OLLAMA_BASE_URL="${{relaticle.OLLAMA_BASE_URL}}" # Ollama endpoint. Default is Ollama cloud. Shared from the relaticle service.
OLLAMA_MODEL="${{relaticle.OLLAMA_MODEL}}" # Tool-capable Ollama model tag, e.g. glm-5.3-flash or gpt-oss:120b. Adds it to the chat model picker. Shared from the relaticle service.
OPENAI_API_KEY="${{relaticle.OPENAI_API_KEY}}" # OpenAI API key for chat models. Optional. Shared from the relaticle service.
QUEUE_CONNECTION="${{relaticle.QUEUE_CONNECTION}}" # Queue backend used by Horizon. Shared from the relaticle service.
REDIS_HOST="${{relaticle.REDIS_HOST}}" # Redis host, from the redis-relaticle service. Shared from the relaticle service.
REDIS_PASSWORD="${{relaticle.REDIS_PASSWORD}}" # Redis password, from the redis-relaticle service. Shared from the relaticle service.
REDIS_PORT="${{relaticle.REDIS_PORT}}" # Redis port, from the redis-relaticle service. Shared from the relaticle service.
REQUIRE_EMAIL_VERIFICATION="${{relaticle.REQUIRE_EMAIL_VERIFICATION}}" # Require email verification on signup. Needs MAIL_* configured when true. Shared from the relaticle service.
REVERB_APP_ID="${{relaticle.REVERB_APP_ID}}" # Reverb app id (auto-generated). Shared from the relaticle service.
REVERB_APP_KEY="${{relaticle.REVERB_APP_KEY}}" # Reverb public key (auto-generated). Injected into the JS bundle at boot. Shared from the relaticle service.
REVERB_APP_SECRET="${{relaticle.REVERB_APP_SECRET}}" # Reverb secret (auto-generated). Shared from the relaticle service.
REVERB_HOST="${{relaticle.REVERB_HOST}}" # Public host of the reverb service. Shared from the relaticle service.
REVERB_PORT="${{relaticle.REVERB_PORT}}" # Reverb public port (Railway terminates TLS). Shared from the relaticle service.
REVERB_SCHEME="${{relaticle.REVERB_SCHEME}}" # Reverb public scheme. Shared from the relaticle service.
