ANTHROPIC_API_KEY="" # Anthropic API key for Claude models. Optional.
APP_DEBUG="false" # Enable Laravel debug mode. Keep false in production.
APP_ENV="production" # Laravel environment. Keep as production.
APP_KEY=base64:${{secret(43,"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")}}= # Laravel encryption key (auto-generated, 32 bytes).
APP_NAME="Relaticle" # Application name shown in the UI and emails.
APP_PANEL_DOMAIN="" # Optional separate domain for the admin panel. Leave empty to serve on APP_URL.
APP_TIMEZONE="UTC" # Application timezone.
APP_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}" # Public URL of the app. Defaults to the Railway-provided domain.
AUTORUN_ENABLED="true" # Run serversideup/php Laravel automations on boot.
AUTORUN_LARAVEL_MIGRATION="true" # Run database migrations automatically on deploy.
AUTORUN_LARAVEL_MIGRATION_ISOLATION="true" # Use migrate --isolated so only one instance migrates.
BROADCAST_CONNECTION="reverb" # Realtime broadcasting driver.
CACHE_STORE="redis" # Cache backend.
DB_CONNECTION="pgsql" # Database driver. Postgres.
DB_DATABASE="${{pg-relaticle.PGDATABASE}}" # Postgres database name, from the pg-relaticle service.
DB_HOST="${{pg-relaticle.PGHOST}}" # Postgres host, from the pg-relaticle service.
DB_PASSWORD="${{pg-relaticle.POSTGRES_PASSWORD}}" # Postgres password, from the pg-relaticle service.
DB_PORT="${{pg-relaticle.PGPORT}}" # Postgres port, from the pg-relaticle service.
DB_USERNAME="${{pg-relaticle.POSTGRES_USER}}" # Postgres user, from the pg-relaticle service.
GOOGLE_CLIENT_ID="" # Google OAuth client id for 'Continue with Google'. Optional.
GOOGLE_CLIENT_SECRET="" # Google OAuth client secret. Optional.
GOOGLE_REDIRECT_URI="https://${{RAILWAY_PUBLIC_DOMAIN}}/auth/callback/google" # Register this as the authorized redirect URI in Google Cloud.
LOG_CHANNEL="stderr" # Laravel log channel. stderr sends logs to Railway.
LOG_LEVEL="warning" # Minimum log level.
MAIL_ENCRYPTION="tls" # SMTP encryption.
MAIL_FROM_ADDRESS="hello@example.com" # From address for outgoing email.
MAIL_FROM_NAME="Relaticle" # From name for outgoing email.
MAIL_HOST="" # SMTP host. Only needed if MAIL_MAILER=smtp.
MAIL_MAILER="log" # Mail transport. log writes emails to the log. Set to smtp and fill MAIL_HOST/USERNAME/PASSWORD to send real email.
MAIL_PASSWORD="" # SMTP password. Only needed if MAIL_MAILER=smtp.
MAIL_PORT="587" # SMTP port.
MAIL_USERNAME="" # SMTP username. Only needed if MAIL_MAILER=smtp.
OLLAMA_API_KEY="" # Ollama cloud API key (https://ollama.com/settings/keys). Leave empty to skip.
OLLAMA_BASE_URL="https://ollama.com" # Ollama endpoint. Default is Ollama cloud.
OLLAMA_MODEL="" # Tool-capable Ollama model tag, e.g. glm-5.3-flash or gpt-oss:120b. Adds it to the chat model picker.
OPENAI_API_KEY="" # OpenAI API key for chat models. Optional.
QUEUE_CONNECTION="redis" # Queue backend used by Horizon.
REDIS_HOST="${{redis-relaticle.REDISHOST}}" # Redis host, from the redis-relaticle service.
REDIS_PASSWORD="${{redis-relaticle.REDIS_PASSWORD}}" # Redis password, from the redis-relaticle service.
REDIS_PORT="${{redis-relaticle.REDISPORT}}" # Redis port, from the redis-relaticle service.
REQUIRE_EMAIL_VERIFICATION="false" # Require email verification on signup. Needs MAIL_* configured when true.
REVERB_APP_ID=${{secret(8,"0123456789")}} # Reverb app id (auto-generated).
REVERB_APP_KEY=${{secret(40,"0123456789abcdef")}} # Reverb public key (auto-generated). Injected into the JS bundle at boot.
REVERB_APP_SECRET=${{secret(64,"0123456789abcdef")}} # Reverb secret (auto-generated).
REVERB_HOST="${{reverb.RAILWAY_PUBLIC_DOMAIN}}" # Public host of the reverb service.
REVERB_PORT="443" # Reverb public port (Railway terminates TLS).
REVERB_SCHEME="https" # Reverb public scheme.
SESSION_DRIVER="redis" # Session backend.
